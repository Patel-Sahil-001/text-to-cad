{
  "version": 2,
  "name": "text-to-cad-studio",
  "builds": [
    {
      "src": "dashboard/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://text-to-cad.onrender.com/api/$1"
    },
    {
      "src": "/outputs/(.*)",
      "dest": "https://text-to-cad.onrender.com/outputs/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard/static/$1"
    }
  ]
}
